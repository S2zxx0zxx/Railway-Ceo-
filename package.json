{
  "name": "the-ceo-company-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-icons.mjs && node scripts/runtime-licenses.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "android:sync": "npm run build && node scripts/prepare-android.mjs",
    "audit:resources": "node scripts/resource-inventory.mjs",
    "audit:bundle": "node scripts/audit-bundle.mjs",
    "android:apk": "npm run android:sync && node scripts/android-build.mjs assembleDebug",
    "android:aab": "npm run android:sync && node scripts/android-build.mjs bundleRelease",
    "audit:licenses": "node scripts/runtime-licenses.mjs",
    "android:sign": "node scripts/sign-android.mjs",
    "audit:source": "node scripts/release-source-audit.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.0.0",
    "@capacitor/android": "8.0.0",
    "dexie": "^4.0.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0",
    "@capacitor/app": "8.0.0",
    "@capacitor/filesystem": "8.0.0",
    "@capacitor/share": "8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0",
    "@vitejs/plugin-react": "^4.5.0"
  }
}
